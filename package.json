{
  "name": "unofficial-fb-api",
  "version": "1.0.0",
  "description": "Educational Facebook Messenger API reverse engineering example - FOR LEARNING ONLY. Based on facebook-chat-api concept by Schmavery.",
  "keywords": [
    "education",
    "reverse-engineering",
    "web-scraping",
    "research",
    "learning",
    "facebook-api-demo",
    "unofficial",
    "academic",
    "tutorial",
    "educational-purpose",
    "facebook-chat-api",
    "inspired-by",
    "typescript-rewrite"
  ],
  "homepage": "https://github.com/nhatvu2003/Unofficial-fb-api#readme",
  "bugs": {
    "url": "https://github.com/nhatvu2003/Unofficial-fb-api/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nhatvu2003/Unofficial-fb-api.git"
  },
  "license": "MIT",
  "author": {
    "name": "Nhat Vu",
    "email": "nhatvu10092003@gmail.com"
  },
  "funding": {
    "type": "individual",
    "url": "https://github.com/sponsors/nhatvu2003"
  },
  "type": "module",
  "main": "./dist/nvstudio.js",
  "types": "./dist/nvstudio.d.ts",
  "exports": {
    ".": {
      "types": "./dist/nvstudio.d.ts",
      "default": "./dist/nvstudio.js"
    }
  },
  "files": [
    "dist/**/*",
    "README.md",
    "LICENSE",
    "SECURITY.md",
    "CODE_OF_CONDUCT.md"
  ],
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "test": "node -e \"console.log('No tests yet')\"",
    "lint": "eslint src/**/*.ts --fix",
    "format": "prettier --write \"src/**/*.ts\" \"types/**/*.ts\" \"*.ts\"",
    "format:js": "prettier --write \"dist/**/*.js\" \"*.js\"",
    "clean": "rimraf dist",
    "type-check": "tsc --noEmit",
    "prepare": "npm run build",
    "prepublishOnly": "npm run clean && npm run build",
    "postpublish": "git tag v1.0.0 && git push --tags"
  },
  "dependencies": {
    "cheerio": "^1.1.2",
    "form-data": "^4.0.0",
    "got": "^14.4.7",
    "https-proxy-agent": "^7.0.6",
    "mqtt": "^5.14.0",
    "tough-cookie": "^6.0.0",
    "ws": "^8.18.3"
  },
  "devDependencies": {
    "@types/cheerio": "^0.22.35",
    "@types/got": "^9.6.12",
    "@types/mqtt": "^0.0.34",
    "@types/node": "^24.3.0",
    "@types/tough-cookie": "^4.0.5",
    "@types/ws": "^8.18.1",
    "@typescript-eslint/eslint-plugin": "^8.47.0",
    "@typescript-eslint/parser": "^8.47.0",
    "eslint": "^9.34.0",
    "jest": "^30.0.5",
    "prettier": "^3.6.2",
    "rimraf": "^6.0.1",
    "typescript": "^5.9.2"
  }
}
